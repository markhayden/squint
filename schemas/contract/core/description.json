{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:table-manners:core:description",
  "title": "Description document (CONTRACT.md 3; readiness 3.1; renders 3.2; the images profile's fields, 11.2)",
  "description": "What a tool does, in terms a client needs nothing else to call it by: `<tool> describe --json` and the describe MCP tool.",
  "type": "object",
  "required": [
    "contract",
    "profiles",
    "tool",
    "actions",
    "progress_interval_s",
    "resources"
  ],
  "properties": {
    "contract": {
      "$ref": "urn:table-manners:core:result#/$defs/version"
    },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "images"
        ]
      },
      "description": "The profiles the tool implements; [] for a core-only tool."
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "purpose"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "confidence",
        "evidence",
        "score_kind"
      ],
      "description": "Images profile: every word the tool emits in a location's disposition, confidence, evidence and score_kind.",
      "properties": {
        "disposition": {
          "$ref": "#/$defs/words"
        },
        "confidence": {
          "$ref": "#/$defs/words"
        },
        "evidence": {
          "$ref": "#/$defs/words"
        },
        "score_kind": {
          "$ref": "#/$defs/words"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inline_bytes"
      ],
      "properties": {
        "inline_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Images profile."
    },
    "progress_interval_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "The longest gap between progress notifications on a live run."
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9+.-]*://"
      }
    }
  },
  "patternProperties": {
    "^x-[a-z][a-z0-9-]*$": {}
  },
  "additionalProperties": false,
  "if": {
    "required": [
      "profiles"
    ],
    "properties": {
      "profiles": {
        "contains": {
          "const": "images"
        }
      }
    }
  },
  "then": {
    "required": [
      "vocabulary",
      "limits"
    ],
    "properties": {
      "actions": {
        "items": {
          "required": [
            "images",
            "locations",
            "outputs"
          ]
        }
      }
    }
  },
  "else": {
    "properties": {
      "vocabulary": false,
      "limits": false,
      "actions": {
        "items": {
          "properties": {
            "images": false,
            "locations": false,
            "outputs": false
          }
        }
      }
    }
  },
  "$defs": {
    "words": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "purpose",
        "params_schema",
        "cost",
        "readiness",
        "duration",
        "renders"
      ],
      "properties": {
        "name": {
          "allOf": [
            {
              "$ref": "urn:table-manners:core:result#/$defs/action_name"
            },
            {
              "not": {
                "enum": [
                  "describe",
                  "estimate"
                ]
              }
            }
          ],
          "description": "The MCP tool name; describe and estimate are reserved (CONTRACT.md 5)."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "role",
              "required"
            ],
            "properties": {
              "slot": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "role": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "required": {
                "type": "boolean"
              },
              "many": {
                "type": "boolean",
                "description": "The slot takes a non-empty list of images (CONTRACT.md 10.1); false when absent."
              }
            }
          },
          "description": "Images profile."
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "kinds",
              "required"
            ],
            "properties": {
              "slot": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "kinds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "bbox",
                    "polygon",
                    "line",
                    "stroke",
                    "mask",
                    "whole_image",
                    "absent",
                    "view"
                  ]
                }
              },
              "required": {
                "type": "boolean"
              }
            }
          },
          "description": "Images profile."
        },
        "params_schema": {
          "type": "object",
          "description": "A JSON Schema for the action's other arguments."
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "images",
            "locations"
          ],
          "properties": {
            "images": {
              "$ref": "#/$defs/words",
              "description": "The roles of the images the action returns."
            },
            "locations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "found"
                ]
              }
            }
          },
          "description": "Images profile."
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "may_spend"
          ],
          "properties": {
            "may_spend": {
              "type": "boolean"
            },
            "basis": {
              "enum": [
                "measured",
                "estimated"
              ]
            }
          },
          "if": {
            "properties": {
              "may_spend": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "basis"
            ]
          }
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typical_s",
            "max_s"
          ],
          "properties": {
            "typical_s": {
              "type": "number",
              "minimum": 0
            },
            "max_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "renders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "kind": {
                "enum": [
                  "document",
                  "server"
                ],
                "description": "document: writes a file and prints its absolute path; server: prints its URL once listening and serves until stdin closes or SIGTERM (CONTRACT.md 3.2)."
              },
              "ready_timeout_s": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60,
                "description": "Server renders: the longest wait for the URL line."
              },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "if": {
              "properties": {
                "kind": {
                  "const": "server"
                }
              }
            },
            "then": {
              "required": [
                "ready_timeout_s"
              ]
            },
            "else": {
              "properties": {
                "ready_timeout_s": false
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "cost": {
            "properties": {
              "may_spend": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "params_schema": {
            "required": [
              "properties"
            ],
            "properties": {
              "properties": {
                "required": [
                  "max_spend_usd"
                ],
                "properties": {
                  "max_spend_usd": {
                    "required": [
                      "type",
                      "exclusiveMinimum"
                    ],
                    "properties": {
                      "type": {
                        "const": "number"
                      },
                      "exclusiveMinimum": {
                        "const": 0
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "description": "An action that may spend declares max_spend_usd, a number above zero, so a host can always pass its cap (CONTRACT.md 4.5)."
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "requirements"
      ],
      "description": "Whether the action can run here, now, and what stands in the way (CONTRACT.md 3.1). Never a credential value.",
      "properties": {
        "state": {
          "enum": [
            "ready",
            "needs_setup",
            "unavailable"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ready"
              }
            }
          },
          "then": {
            "properties": {
              "requirements": {
                "items": {
                  "properties": {
                    "state": {
                      "not": {
                        "enum": [
                          "missing",
                          "invalid"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "needs_setup"
              }
            }
          },
          "then": {
            "properties": {
              "requirements": {
                "contains": {
                  "properties": {
                    "state": {
                      "enum": [
                        "missing",
                        "invalid"
                      ]
                    }
                  },
                  "required": [
                    "state"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "requirements": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "state"
      ],
      "properties": {
        "kind": {
          "enum": [
            "config",
            "credential",
            "env",
            "model",
            "file",
            "dependency"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "enum": [
            "missing",
            "present",
            "valid",
            "invalid",
            "unknown"
          ]
        },
        "setup": {
          "type": "string",
          "minLength": 1,
          "description": "A sentence a person can act on."
        }
      }
    }
  }
}
