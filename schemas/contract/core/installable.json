{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:table-manners:core:installable",
  "title": "Installable (CONTRACT.md 3.5)",
  "description": "Something a tool can install on request, such as a model: what it is, what it costs to install, and whether it is installed. Its state is read from disk; describe stays a local inspection.",
  "type": "object",
  "required": [
    "id",
    "title",
    "kind",
    "download_bytes",
    "installed_bytes",
    "licence",
    "state",
    "requirements",
    "last_outcome"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "enum": [
        "model"
      ],
      "description": "The only kind 0.6.0 defines."
    },
    "download_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "installed_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "licence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The licence the installed files are under, as their maker states it."
    },
    "state": {
      "enum": [
        "installed",
        "not_installed",
        "installing",
        "unavailable"
      ]
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Only while installing: the share done."
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "urn:table-manners:core:description#/$defs/requirement"
      },
      "description": "What installing needs (free disk, say); never what running needs, which the actions' readiness says."
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "last_outcome": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/outcome"
        }
      ],
      "description": "The most recent install or uninstall that finished, until the next one starts."
    }
  },
  "patternProperties": {
    "^x-[a-z][a-z0-9-]*$": {}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "installing"
          }
        }
      },
      "then": {},
      "else": {
        "properties": {
          "progress": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "required": [
          "notes"
        ]
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "unavailable",
            "busy",
            "failed",
            "cancelled"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "For a person; never a credential value."
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "state",
        "error",
        "at"
      ],
      "properties": {
        "action": {
          "enum": [
            "install",
            "uninstall"
          ]
        },
        "state": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
