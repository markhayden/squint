{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:table-manners:core:refusal",
  "title": "Refusal data (CONTRACT.md 3.1, 4.4, 4.5, 4.7, 5.1)",
  "description": "The `data` of a JSON-RPC -32602 error the contract names, so a host can tell it from other invalid params.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reason",
    "run"
  ],
  "properties": {
    "reason": {
      "enum": [
        "client_run_id_reused",
        "not_ready",
        "invalid_arguments",
        "binding"
      ]
    },
    "run": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "urn:table-manners:core:run-ref"
        }
      ],
      "description": "client_run_id_reused: the earlier request's run, null while it has none (queued, or cancelled before allocation). not_ready, invalid_arguments and binding: always null."
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:table-manners:core:description#/$defs/requirement"
      },
      "description": "not_ready: the requirements this call needs that are missing or invalid."
    },
    "error": {
      "$ref": "urn:table-manners:core:result#/$defs/error_object",
      "description": "invalid_arguments: what was wrong, as in a result (code usage or input, not retryable)."
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:table-manners:operations:binding"
      },
      "description": "binding: one entry per reference that failed, in port order and, within a many port, in the order given (4.7)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reason": {
            "const": "not_ready"
          }
        }
      },
      "then": {
        "required": [
          "requirements"
        ],
        "properties": {
          "run": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "requirements": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": {
            "const": "invalid_arguments"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "run": {
            "type": "null"
          },
          "error": {
            "properties": {
              "code": {
                "enum": [
                  "usage",
                  "input"
                ]
              },
              "retryable": {
                "const": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "error": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": {
            "const": "binding"
          }
        }
      },
      "then": {
        "required": [
          "bindings"
        ],
        "properties": {
          "run": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "bindings": false
        }
      }
    }
  ]
}
