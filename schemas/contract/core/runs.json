{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:table-manners:core:runs",
  "title": "Runs list (CONTRACT.md 4.3)",
  "description": "The `<tool>://runs{?cursor}` resource: one page of runs, newest first, so a run is discoverable without its id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "tool",
    "runs",
    "next_cursor"
  ],
  "properties": {
    "contract": {
      "$ref": "urn:table-manners:core:result#/$defs/version"
    },
    "tool": {
      "$ref": "urn:table-manners:core:result#/$defs/tool"
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "urn:table-manners:core:run-ref#/$defs/run_ref",
        "required": [
          "action",
          "status",
          "started"
        ],
        "properties": {
          "action": {
            "$ref": "urn:table-manners:core:result#/$defs/action_name"
          },
          "status": {
            "enum": [
              "running",
              "completed",
              "cancelled",
              "error",
              "invalid"
            ]
          },
          "started": {
            "type": "string",
            "format": "date-time"
          }
        },
        "unevaluatedProperties": false
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._~-]{1,256}$",
      "description": "Opaque, URI-unreserved characters only, so it goes into <tool>://runs?cursor=<next_cursor> unencoded. Null on the last page."
    }
  }
}
