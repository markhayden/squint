{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:table-manners:core:runs",
  "title": "Runs list (CONTRACT.md 4.3)",
  "description": "The `<tool>://runs` resource: recent runs, newest first, so a run is discoverable without its id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "tool",
    "runs"
  ],
  "properties": {
    "contract": {
      "$ref": "urn:table-manners:core:result#/$defs/version"
    },
    "tool": {
      "$ref": "urn:table-manners:core:result#/$defs/tool"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "status",
          "started",
          "resource"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "$ref": "urn:table-manners:core:result#/$defs/action_name"
          },
          "status": {
            "enum": [
              "running",
              "completed",
              "cancelled",
              "error",
              "invalid"
            ]
          },
          "started": {
            "type": "string",
            "format": "date-time"
          },
          "resource": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9+.-]*://run/"
          }
        }
      }
    }
  }
}
