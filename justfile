# squint developer recipes. See docs/bootstrap.md for the one manual step (installing just).

set shell := ["bash", "-euo", "pipefail", "-c"]

deny_version := "0.20.2"
dist_version := "0.33.1"
nextest_version := "0.9.148"

# Install the pinned helper tools (idempotent).
bootstrap:
    cargo install cargo-deny --version {{deny_version}} --locked
    cargo install cargo-dist --version {{dist_version}} --locked
    cargo install cargo-nextest --version {{nextest_version}} --locked
    @command -v uv >/dev/null || echo "uv not found: install from https://docs.astral.sh/uv/ (the Python tool pack needs it)"

# Everything a commit must pass: fmt, clippy and tests in both feature configurations, deny, graph.
check: fmt-check clippy test deny graph packaging attribution hooks-test checks-test

fmt-check:
    cargo fmt --all -- --check

# Only squint-cli has a feature (`testkit`), so only it is checked both ways: the workspace with
# the feature, then squint-cli without it (the release build's behaviour, no test seams).
clippy:
    cargo clippy --workspace --all-targets --features squint-cli/testkit -- -D warnings
    cargo clippy -p squint-cli --all-targets -- -D warnings

# nextest runs the test binaries in parallel (cargo test runs them one after another). There are
# no doctests to lose.
# The fake MCP server is built once first: nextest runs every test as its own process, and a
# build per process would race to replace the binary under the tests running it.
test:
    cargo build -p squint-testkit --bin squint-testkit-mcp
    SQUINT_TESTKIT_MCP="$PWD/target/debug/squint-testkit-mcp" cargo nextest run --workspace --features squint-cli/testkit
    SQUINT_TESTKIT_MCP="$PWD/target/debug/squint-testkit-mcp" cargo nextest run -p squint-cli

# Licences, bans and sources work offline; advisories need the network and run in CI (`just deny-advisories`).
deny:
    cargo deny check licenses bans sources

deny-advisories:
    cargo deny check advisories

graph:
    scripts/check-crate-graph.sh

# Every embedded asset sits inside its crate and in the file list `cargo package` ships.
packaging:
    scripts/check-packaging.sh

# Package and verify every crate as `cargo publish` would, without uploading (network for the index).
publish-dry-run:
    scripts/publish.sh --dry-run

# Install `squint` from the packaged .crate files outside the repository and run the offline smoke.
registry-install-test:
    scripts/registry-install-test.sh

# The offline smoke against any built binary, for example `just smoke target/release/squint`.
smoke binary="target/debug/squint":
    scripts/offline-smoke.sh {{binary}}

# The release workflow is generated by `dist` from dist-workspace.toml; fail if it is stale.
dist-check:
    dist generate --check
    dist plan

# Build this machine's release archive into target/distrib/ as the release workflow would (the
# other targets cross-compile only on their own runners).
archive-build:
    dist build --artifacts=local --target="$(rustc -vV | sed -n 's/^host: //p')"

# Unpack a release archive in a scratch directory and run the offline smoke on its binary.
archive-smoke archive:
    scripts/archive-smoke.sh {{archive}}

# The live smoke: one `check` per direct profile whose key and account are in the environment,
# from any binary (an unpacked archive for the release record). Spends a few cents per vendor.
live-smoke binary="target/debug/squint":
    scripts/live-smoke.sh {{binary}}

# Run one filtered suite and fail if the filter selects no tests.
# Usage: just check-filter squint-core -- image frames
check-filter package *filters:
    scripts/check-filter.sh {{package}} {{filters}}

# The Python tool pack: lint, format check and tests (needs uv; network on the first `uv sync`).
python-check:
    cd tools/python && uv sync --frozen && uv run --frozen --offline --no-sync ruff check . && uv run --frozen --offline --no-sync ruff format --check . && uv run --frozen --offline --no-sync pytest -q

# The Rust client against the real Python pack (needs uv and the synced environment above).
pack-test: python-check
    cargo test -p squint-tools --test it -- --ignored python_pack::
    cargo test -p squint-cli --test it -- --ignored python_pack_manifests::

# The set-building toolkit (scripts/sets): lint, format check, tests, and the offline dry run
# checked by the harness (needs uv; network on the first `uv sync`).
sets-check:
    cd scripts/sets && uv sync --frozen && uv run --frozen --offline --no-sync ruff check . && uv run --frozen --offline --no-sync ruff format --check . && uv run --frozen --offline --no-sync pytest -q
    scripts/sets-dry-run.sh

# Build the pack's provisioning bundle into tools/python/dist/bundle-<version>/.
bundle:
    scripts/build-bundle.sh

# Install the built bundle into a clean directory and call the pack through MCP (needs uv).
provisioning-test: bundle
    cargo test -p squint-tools --test it -- --ignored provisioning::

# No agent attribution in any commit message or tracked file.
attribution:
    scripts/check-attribution.sh

# Install the git hooks (task 0.2): pre-commit (credential scan, fmt, clippy) and commit-msg
# (no agent attribution).
hooks:
    git config core.hooksPath scripts/hooks

# Prove the credential scanner behind the pre-commit hook accepts and rejects what it must.
hooks-test:
    scripts/test-hooks.sh

# Prove the repository checks (crate graph, filter) fail when they should.
checks-test:
    scripts/test-checks.sh

# Run the GitHub Actions CI workflow locally in Docker with act (brew install act). First run pulls
# the runner image and builds from scratch; later runs reuse the image.
# Pass a job name to run one job: `just ci-local rust`.
ci-local job="":
    act push {{ if job == "" { "" } else { "-j " + job } }} -P ubuntu-latest=catthehacker/ubuntu:act-latest --container-architecture linux/amd64 --rm
